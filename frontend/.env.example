# Base URL for the FastAPI backend.
# - `/api` (recommended in dev): vite.config.ts proxies it to VITE_API_PROXY_TARGET
#   and strips the prefix, so the browser stays same-origin (no CORS).
# - Absolute URL (production): e.g. https://api.example.com
# Remember: every VITE_* value is embedded in the public bundle. No secrets here.
VITE_API_URL=/api

# Identity sent as X-User-Id. The backend creates it on demand when
# AUTO_CREATE_USERS=true, or matches an existing user by username/UUID.
VITE_USER_ID=default

# Only needed when the backend defines CRAG_API_KEY (sent as X-API-Key).
# VITE_API_KEY=

# Optional: dev/preview proxy target (default http://127.0.0.1:8000).
# Use http://backend:8000 inside docker-compose.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only for Docker/VM/network drives: filesystem polling watcher (slower).
# CHOKIDAR_USEPOLLING=true
