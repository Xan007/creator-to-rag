GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
APIFY_API_KEY=your_apify_api_key_here
# Low-cost social actors; override if an actor changes its input/output contract.
APIFY_TIKTOK_ACTOR=clockworks/full-tiktok-api-scraper
APIFY_MAX_TOTAL_CHARGE_USD=1.00
# Temporary disk cache of Apify datasets (~/.crag/apify_cache). Skip/index
# logic still runs on cached items. Set APIFY_CACHE=false to disable.
# APIFY_CACHE=true
# APIFY_CACHE_TTL_HOURS=24

# Keep one provider fixed for the lifetime of a Pinecone index.
EMBED_PROVIDER=fastembed
# Must match an existing Pinecone index name and its embedding dimension.
# Legacy INSTARAG_* env vars are still accepted as fallbacks.
CRAG_PINECONE_INDEX=creatorrag

# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# FILTER_PROVIDER=gemini
# FILTER_MODEL=gemini-3.5-flash

# Answers: gemini | openai | groq. Groq default is openai/gpt-oss-120b
# (llama-3.3-70b-versatile was shut down for free/developer on 2026-08-16).
# RAG_PROVIDER=groq
# RAG_MODEL=openai/gpt-oss-120b
# RAG_PROVIDER=gemini
# RAG_MODEL=gemini-3.5-flash

# Extraction is intentionally configurable independently from answer generation.
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
# Optional comma-separated extras, tried before the built-in Flash chain.
# GEMINI_EXTRACTION_FALLBACK_MODELS=
GEMINI_MAX_CONCURRENT_REQUESTS=1

# Shrink videos before Gemini upload (ffmpeg). 720p is enough to read overlays.
# GEMINI_VIDEO_OPTIMIZE=true
# GEMINI_VIDEO_MAX_HEIGHT=720

# Caption-first ingest: gray-zone captions use the RAG answer model
# (RAG_PROVIDER / RAG_MODEL, e.g. Groq). Gemini stays on video extraction.
# CAPTION_TRIAGE_MODEL=  # optional override; defaults to RAG_MODEL
# HYDRATE_ON_QUERY=true

# CRAG_DATABASE_URL=postgresql+psycopg://postgres:password@db.xxx.supabase.co:5432/postgres

PORT=8000
CRAG_HOST=0.0.0.0
CRAG_PORT=8000

# Bounded parallelism for multi-URL ingestion (default: 3, maximum: 4).
INGEST_WORKERS=3

# CRAG_API_KEY=your_secret_api_key_here
# CRAG_CORS_ORIGINS=http://localhost:3000,https://myfrontend.com
# CRAG_USER=default_user
# CRAG_AUTO_CREATE_USERS=true
